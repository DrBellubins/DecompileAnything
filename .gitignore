.pi/

# machine-specific: recreate with Docs/Setup.md
.venv/
__pycache__/
*.egg-info/
build/
dist/

%SystemDrive%/

Tests/Proprietary/

# Ghidra analysis cache (Docs/Setup.md §3): the Ghidra project + analysis.db per target
cache/

# MSVC toolchains and the Wine prefix (Docs/Setup.md §6): downloaded under Microsoft's
# non-redistributable licence, rebuilt by the setup steps, never committed. The two drivers
# that rebuild them are ours, so they are committed.
toolchains/*
!toolchains/*.py
.wine/

# generated by Tests/tools/check_phase5_ledger.py: the benchmark project with its cache pointed
# at a copy, so a match ledger cannot change what the other suites measure
Tests/phase5-scratch.toml
